# LSEG Workspace Desktop Session — requires Workspace app running on same PC
# Generate APP_KEY inside Workspace: App Key Generator → new "Desktop Session" key
LSEG_APP_KEY=your_app_key_here

# Backend server
HOST=127.0.0.1
PORT=8000

# Logging
LOG_LEVEL=INFO

# Optional: MAS API portal key (eservices.mas.gov.sg/apimg-portal — guest signup).
# Used as official fallback/validator feed for daily SORA & FX when present.
MAS_API_KEY=
